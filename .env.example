# Learning Platform — Compose env example
# Copy to repo root as `.env` and replace secrets. Never commit real values.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (dev / production-ish) ---
POSTGRES_USER=lp
POSTGRES_PASSWORD=lp_dev_change_me
POSTGRES_DB=learning_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lp:lp_dev_change_me@postgres:5432/learning_platform?schema=public

# --- Postgres (test profile / docker-compose.test.yml) ---
POSTGRES_TEST_USER=lp_test
POSTGRES_TEST_PASSWORD=lp_test
POSTGRES_TEST_DB=lp_test
DATABASE_TEST_URL=postgresql://lp_test:lp_test@postgres-test:5432/lp_test?schema=public

# --- API ---
API_PORT=3000
API_HOST_PORT=3000
JWT_SECRET=dev-only-change-me-in-prod

# --- Web ---
WEB_PORT=3001
WEB_HOST_PORT=3001
# Browser-facing API URL (host machine)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-side URL inside the compose network
API_URL=http://api:3000

# --- MCP ---
MCP_HTTP_PORT=3100
MCP_HOST_PORT=3100
API_BASE_URL=http://api:3000

# --- Object storage (profile: assets / MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lp-assets
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
