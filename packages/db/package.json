{
  "name": "@lp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "node ./dist/migrate-deploy.js",
    "drizzle:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lp/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@lp/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.2"
  }
}
